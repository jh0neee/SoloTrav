# ─────────────────────────────────────────────
# SoloTrav Web 전용 설정. 복사해서 .env 로 쓰세요. (cp .env.example .env)
# 앱(../SoloTrav/.env)과는 별개 파일입니다.
# ─────────────────────────────────────────────

# API 주소. 슬래시로 시작하면 dev 서버 자신을 가리키고,
# vite.config.ts 의 proxy 가 실제 서버로 중계합니다. (CORS 회피)
VITE_API_BASE_URL=/api

# 프록시가 실제로 찌를 서버
# VITE_API_PROXY_TARGET=https://mixed-light.kr
VITE_API_PROXY_TARGET= http://hj.tcs.local:3000

VITE_API_VERSION=v1
VITE_API_TIMEOUT_MS=15000

# ── 카카오 (developers.kakao.com > 내 애플리케이션 > 앱 키) ──
# 한 앱에 키가 4종류 있고, 지도와 로그인이 서로 **다른 키**를 씁니다.
# 이름이 비슷해 헷갈리기 쉬우니 콘솔에서 각각 복사해 넣으세요.

# 지도용 — 반드시 'JavaScript 키'
# 플랫폼 > Web > 사이트 도메인에 http://localhost:5180 등록 필수
VITE_KAKAO_JS_KEY=

# 로그인용 — 반드시 'REST API 키' (JS 키와 다른 값입니다)
# 카카오 로그인 > Redirect URI 에 http://localhost:5180/kakao-callback.html 등록 필수
# 카카오 로그인 > 보안 > Client Secret 은 '사용 안 함' 이어야 브라우저에서 토큰 교환이 됩니다.
VITE_KAKAO_REST_API_KEY=
