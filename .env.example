# ─────────────────────────────────────────────
# 이 파일을 복사해서 .env 로 만들어 사용하세요.
#   cp .env.example .env
# .env 는 커밋되지 않습니다(.gitignore).
# 값을 바꾼 뒤에는 `npm start -- --reset-cache` 로 Metro 캐시를 비워야 반영됩니다.
# ─────────────────────────────────────────────

# API 서버 주소 (버전 경로 제외)
API_BASE_URL=http://hj.tcs.local:3000/api

# API 버전 — 최종 baseURL = ${API_BASE_URL}/${API_VERSION}
API_VERSION=v1

# 요청 타임아웃 (ms)
API_TIMEOUT_MS=15000
